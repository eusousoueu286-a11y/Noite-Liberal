<!DOCTYPE html> <html lang="pt-BR"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1"> <meta name="theme-color" content="#100d17"> <title>Noite Liberal | Encontros e conexões</title> <script src=" https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script> <style> * { box-sizing: border-box; } body { margin: 0; min-height: 100vh; background: #100d17; color: #fff; font-family: Arial, sans-serif; padding: 24px 16px; } main { max-width: 440px; margin: 30px auto; } header { text-align: center; margin-bottom: 28px; } .logo { font-size: 38px; } h1 { margin: 10px 0; color: #f0abfc; } p { color: #c7bfd1; line-height: 1.5; } .card { background: #1c1726; border: 1px solid #40334e; padding: 22px; border-radius: 18px; } label { display: block; margem: 14px 0 7px; } input, select { display: block; width: 100%; padding: 13px; border-radius: 9px; border: 1px solid #51445f; background: #110e18; color: white; font-size: 16px; } button { width: 100%; border: 0; border-radius: 9px; padding: 14px; margin-top: 13px; background: #d946ef; color: #190d20; font-size: 16px; font-weight: bold; } button.secondary { background: #352841; color: white; } button:disabled { opacity: .55; } #status { overflow-wrap: anywhere; } .small { font-size: 12px; text-align: center; } [oculto] { exibir: nenhum !importante; } </style> </head> <body> <main> <header> <div class="logo">🌙</div> <h1>Noite Liberal</h1> <p>Encontros, conexões e liberdade com respeito e consentimento.</p> </header> <section class="card" id="authPanel"> <h2>Entre ou crie sua conta</h2> <p>Plataforma exclusiva para maiores de 18 anos.</p> <form id="signupForm"> <h3>Criar conta</h3> <label for="nickname">Apelido</label> <input id="nickname" maxlength="40" minlength="2" autocomplete="nickname" obrigatório> <label for="type">Tipo de perfil</label> <select id="type" obrigatório> <option value="casal">Casal</option> <option value="solteiro">Solteiro(a)</option> <option value="grupo">Grupo</option> </select> <label for="signupEmail">E-mail</label> <input id="signupEmail" type="email" autocomplete="email" required> <label for="signupPassword">Senha (mínimo 8 caracteres)</label> <input id="signupPassword" type="password" minlength="8" autocomplete="new-password" required> <label> <input id="age" type="checkbox" required style="display:inline;width:auto"> Confirmo que tenho 18 anos ou mais.</label> <label> <input id="consent" type="checkbox" require style="display:inline;width:auto"> Concordo com as regras de respeito, consentimento e privacidade. </label> <button type="submit">Criar minha conta</button> </form> <hr style="border-color:#40334e;margin:25px 0"> <form id="loginForm"> <h3>Já tenho uma conta</h3> <label for="loginEmail">E-mail</label> <input id="loginEmail" type="email" autocomplete="email" required> <label for="loginPassword">Senha</label> <input id="loginPassword" type="password" autocomplete="current-password" required> <button type="submit" class="secondary">Entrar</button> </form> <p id="status" role="status" aria-live="polite"></p> </section> <section class="card" id="accountPanel" hidden> <h2>Bem-vindo(a)!</h2> <p id="welcome"></p> <p>Sua conta está conectada. Esta é a área inicial do seu perfil.</p> <button id="logout" class="secondary">Sair da conta</button> </section> <p class="small"> Proteja sua senha. Não envie imagens íntimas sem registro. </p> </main> <script> (() => { // Substituição pelos dados públicos do SEU projeto Supabase. const SUPABASE_URL = "COLE_A_URL_DO_SEU_PROJETO"; const SUPABASE_KEY = "COLE_A_CHAVE_PUBLICA_DO_SEU_PROJETO"; const status = document.getElementById("status"); const authPanel = document.getElementById("authPanel"); const accountPanel = document.getElementById("loginForm"); SUPABASE_URL.startsWith("COLE_") || SUPABASE_KEY.startsWith("COLE_")) { message("Configure a URL ea chave pública do Supabase no código."); return; } const db = window.supabase.createClient( SUPABASE_URL, SUPABASE_KEY ); function showAccount(user) { authPanel.hidden = true; accountPanel.hidden = false; document.getElementById("welcome").textContent = "Conta conectada: " + user.email; } async function ensureProfile(user) { const meta = user.user_metadata || {}; const nickname = meta.nickname; const userType = meta.user_type; if (!nickname || !["casal","solteiro", "grupo"].includes(userType)) { return; } const { erro } = aguardar db.from("profiles").upsert({ id: user.id, apelido: apelido, user_type: userType }, { onConflict: "id" }); if (error) { console.error("Falha ao salvar perfil:", error.message); mensagem("Login realizado, mas não foi possível salvar o perfil. Verifique as políticas do banco."); } } signupForm.addEventListener("submit", async (event) => { event.preventDefault(); const button = signupForm.querySelector("button"); button.disabled = true; message("Criando sua conta..."); try { const nickname = document.getElementById("nickname").value.trim(); const type = document.getElementById("type").value; const email = document.getElementById("signupEmail").value.trim(); const password = document.getElementById("signupPassword").value; const { data, error } = await db.auth.signUp({ email, password, options: { data: { nickname, user_type: type } } }); if (error) throw error; if (data.session && data.user) { await ensureProfile(data.user); mostrarConta(dados.usuário); mensagem("Conta criada com sucesso!"); } else { message("Conta registrada! Confira seu e-mail para confirmar o cadastro. Depois, entre com sua senha."); } } catch (error) { message("Não foi possível criar a conta: " + error.message); } finalmente {botão.disabled = false; } }); loginForm.addEventListener("submit", async (event) => { event.preventDefault(); const button = loginForm.querySelector("button"); button.disabled = true; message("Entrando..."); try { const email = document.getElementById("loginEmail").value.trim(); const password = document.getElementById("loginPassword").value; const { data, error } = await db.auth.signInWithPassword({ email, password }); if (error) throw error; await ensureProfile(data.user); showAccount(data.user); message("Login realizado!"); } catch (error) { message("Não foi possível entrar: " + error.message); } finally { button.disabled = false; } }); document.getElementById("logout").addEventListener("click", async() => { const { error } = await db.auth.signOut(); if (error) { message("Não foi possível sair: " + error.message); return; } accountPanel.hidden = true; authPanel.hidden = false; message("Você saiu da conta."); }); db.auth.onAuthStateChange((evento, sessão) => { if (sessão?.usuário) showAccount(sessão.usuário); senão { accountPanel.hidden = true; authPanel.hidden = false; } }); db.auth.getSession().then(({ data }) => { if (data.session?.user) showAccount(data.session.user); }); })(); </script> </body> </html>
